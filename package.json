{
  "name": "deskai2",
  "version": "1.0.0",
  "private": true,
  "description": "Local desktop voice, character conversations, and Work Host",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "npm run desktop:dev",
    "desktop:dev": "node scripts/desktop/launch.mjs",
    "host:serve": "node --experimental-strip-types apps/host/src/server.ts",
    "host:ctl": "node --experimental-strip-types apps/host/src/ctl.ts",
    "desktop:build": "node scripts/desktop/build.mjs",
    "desktop:prepare-asr": "node scripts/desktop/prepare-amadeus-asr.mjs",
    "desktop:prepare-knowledge": "node scripts/desktop/prepare-character-knowledge.mjs",
    "desktop:prepare-live2d": "node scripts/desktop/prepare-live2d.mjs",
    "desktop:preview-nagato": "node scripts/desktop/preview-nagato.mjs",
    "desktop:test": "node --experimental-strip-types --test \"tests/**/*.test.*\"",
    "desktop:pet-smoke": "node scripts/desktop/launch.mjs --pet-smoke",
    "desktop:smoke": "node scripts/desktop/launch.mjs --smoke"
  },
  "dependencies": {
    "@ai-ecoverse/wasm-webrtc-audio-processing": "^2.1.0-2",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@ricky0123/vad-web": "0.0.31",
    "onnxruntime-web": "1.22.0",
    "pixi.js": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "untitled-pixi-live2d-engine": "1.4.0",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "electron": "45.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
